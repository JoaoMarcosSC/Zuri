{
  "compilerOptions": {
    "lib": [
      "es2022"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "schematics",
    "outDir": "../../dist/zuri/schematics",
    "types": []
  },
  "include": [
    "schematics/**/*.ts"
  ],
  "exclude": [
    "schematics/**/*.spec.ts"
  ]
}
